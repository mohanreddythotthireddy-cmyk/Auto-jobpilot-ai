# Optional job discovery API credentials
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional comma-separated public company board identifiers
GREENHOUSE_BOARDS=
LEVER_BOARDS=
ASHBY_BOARDS=
# USAJOBS requires an API key and the email associated with the key
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Search scope and scheduler cadence
JOB_SEARCH_LOCATIONS=Bengaluru,Karnataka,India
INCLUDE_OTHER_INDIAN_CITIES=true
INCLUDE_INDIA_REMOTE=true
SEARCH_POLL_SECONDS=60
ADZUNA_REFRESH_MINUTES=15
ARBEITNOW_REFRESH_MINUTES=30
GREENHOUSE_REFRESH_MINUTES=60
LEVER_REFRESH_MINUTES=60
ASHBY_REFRESH_MINUTES=60
USAJOBS_REFRESH_MINUTES=60
# Optional email reporting
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
REPORT_TO=
# Optional: override the default database path (use a local path)
# JOBPILOT_DB_PATH=data/jobpilot.db
# Optional: override the default master resume path
# MASTER_RESUME_PATH=master_resume.md
